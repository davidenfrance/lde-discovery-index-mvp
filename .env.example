# Postgres (Vercel Postgres / Neon). Required in production.
DATABASE_URL=postgres://USER:PASSWORD@HOST/DB?sslmode=require

# Comma-separated Ed25519 public keys (hex, 32 bytes each) allowed to publish or revoke.
# These are the wallet public addresses. Private keys stay on the wallet.
# Example: generate with: node scripts/sign-example.mjs
ALLOWED_WALLET_ADDRESSES=
