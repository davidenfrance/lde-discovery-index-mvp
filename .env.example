# Postgres (Vercel Postgres or Neon). Required in production.
DATABASE_URL=postgres://USER:PASSWORD@HOST/DB?sslmode=require

# HMAC secret used by signed MVP Wallet AI submissions and revokes.
WALLET_AI_HMAC_SECRET=change-me-mvp-secret

# Comma-separated key ids allowed to publish or revoke records.
ALLOWED_WALLET_KEY_IDS=mvp-wallet-ai-2026,lde-record-2026-08
